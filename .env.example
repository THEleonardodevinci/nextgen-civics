# ---------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------

# --- Supabase (Project Settings -> API Keys) -------------------
#
# Supabase now issues two kinds of keys. Either works here, but prefer the
# NEW ones: the legacy anon/service_role keys are deprecated and scheduled
# for removal at the end of 2026.
#
#   NEW (preferred)   sb_publishable_...  and  sb_secret_...
#   LEGACY            anon  and  service_role  (under the "Legacy API Keys" tab)
#
# The variable names below keep their original spelling so no code has to
# change. Paste whichever key type your project gives you.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. Safe to expose - it is bundled into the browser by
# design and is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret / service_role key. SECRET. Bypasses RLS entirely. Server-side only -
# read solely by route handlers under src/app/api. Never prefix it with
# NEXT_PUBLIC_, and never import createServiceClient() from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Database connection (for npm run db:setup) ----------------
# Only needed to run migrations and seeds from the command line.
# Dashboard -> Connect, or Settings -> Database -> Connection string -> URI.
# Replace [YOUR-PASSWORD] with your database password. Percent-encode any
# special characters in it:  @ -> %40   : -> %3A   / -> %2F   # -> %23
# If the direct host times out, use the "Session pooler" string instead.
DATABASE_URL=postgresql://postgres:yourpassword@db.your-ref.supabase.co:5432/postgres

# --- Site ------------------------------------------------------
# Used for canonical URLs, Open Graph tags, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin enrollment (optional) -------------------------------
# Generate with: node scripts/hash-admin-code.mjs "a long random code"
# Only the hash is stored. Leave unset to disable /admin/enroll entirely.
ADMIN_ACCESS_CODE_HASH=
# Role granted on successful enrollment. SUPER_ADMIN is deliberately not
# grantable this way — see README > Admin bootstrapping.
ADMIN_ENROLL_ROLE=ADMIN

# --- Misc ------------------------------------------------------
# Any random string. Used to salt IP hashes for rate limiting so raw
# addresses are never stored.
RATE_LIMIT_SALT=change-me
